# Copy this file to .env and fill in values locally.
# Never commit .env or paste your token into chat.
# Reset any exposed token in the Discord Developer Portal before use.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Enable Discord Server Members and Message Content intents in the Developer Portal first.
ENABLE_COMMUNITY=true

# Optional streaming providers. Fill locally; never commit real credentials.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Optional one-shot Twitch notifier; stays disabled until explicitly enabled.
# Configure these as GitHub Actions variables for alerts while Codespaces is stopped.
VOIDTIDE_OFFLINE_TWITCH_ENABLED=false
TWITCH_LOGIN=voidtideus
TWITCH_LIVE_CHANNEL_ID=
TWITCH_NOTIFICATION_ROLE_ID=
TWITCH_ALERT_COOLDOWN_MINUTES=5
